# Copy to .env and fill in your values. NEVER commit .env.
# These are read by the frontend at build time via import.meta.env.

# Executor proxy URL (Azure Function that forwards to the iGentic executor)
VITE_EXECUTOR_URL=

# Optional: direct backend base URL (if not going through the proxy)
VITE_API_BASE_URL=

# Auth forwarded to the executor proxy
VITE_USERNAME=
VITE_BEARER_TOKEN=
VITE_API_KEY=
VITE_APP_ID=

# SSE streaming
VITE_STREAMING=true